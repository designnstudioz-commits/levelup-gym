# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI scratch (version cache), not part of the project
supabase/.temp

# Operational artefacts that must never enter the repository.
# Exact filenames, not globs: these are specific files that were found
# sitting in the project root on 2026-10-06 and moved to a restricted
# folder outside it. The rules remain so that regenerating one here
# cannot be committed by accident.
#
# Member PII — the 45-member recovery manifest from the September
# Storage-deletion incident (names, phone numbers, photo paths).
/affected_members_recovery_manifest.csv
# Security audit of the live system (auth/RLS findings).
/Level-Up-Auth-RLS-Audit.pdf
# Product-catalogue upload template. No PII, kept locally for convenience;
# ignored so it is not committed without a deliberate decision.
/Level_Up_Bulk_Product_Upload_Template.xlsx
