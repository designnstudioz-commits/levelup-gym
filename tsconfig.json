{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // "website" is a SEPARATE Next.js app that happens to live in this
  // repository (its own package.json, lockfile, tsconfig and Vercel
  // project). The include globs above are "**/*.ts(x)", so without this it
  // is type-checked as part of the management app, where its "@/..." paths
  // resolve against src/ here and cannot be found.
  "exclude": ["node_modules", "website"]
}
